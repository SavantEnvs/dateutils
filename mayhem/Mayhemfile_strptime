# Mayhem target `strptime` — the dateutils `strptime` command-line tool, one of the utilities src/ ships,
# built sanitized (ASan+UBSan, halting) + SanCov + DWARF-3 by mayhem/build.sh at /mayhem/cli/strptime.
# Raw (non-libFuzzer, process-per-input) target: `strptime -i FORMAT... < input` — parses the date/time strings on stdin with the given strptime(3) formats. The fuzz bytes are staged as `@@` and the wrapper opens that file as the tool's stdin (the shell's `<` redirection, in-process; see mayhem/harnesses/stdin_main.c).
# The explicit 5 s Mayhem `timeout:` is the per-input hang bound; the harness adapter has no timer of its own, so a hanging input is reported by Mayhem as a timeout.
project: savantenvs/dateutils
target: strptime

testsuite:
  - https://$MAYHEM_DOMAIN/$MAYHEM_PROJECT/$MAYHEM_TARGET/testsuite.tar
  - file://mayhem/strptime/testsuite

cmds:
  - cmd: /mayhem/cli/strptime -i %Y-%m-%dT%H:%M:%S -i %Y-%m-%d -i %d.%m.%Y -i %H:%M:%S @@
    timeout: 5
